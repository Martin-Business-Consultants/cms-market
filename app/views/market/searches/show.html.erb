<% @page_title = "Search" %>
<% can_write = Current.user.can?("market:write") %>
<% can_pull = Current.user.can?("market:search") %>
<% pull = @data.last_pull %>

<% content_for :page_actions do %>
  <%= link_to "Pulls", market_search_pulls_path, class: "btn" %>
  <% if can_pull && @settings.search_connected? && @data.profile.domain && !pull&.working? %>
    <%= button_to market_search_pulls_path, class: "btn btn--primary", form_class: "contents",
          title: "At most #{market_money Market::SearchPull.ceiling(settings: @settings)}; #{market_money @settings.remaining_budget} left this month" do %>
      <%= icon_tag "refresh" %> <span>Pull search data</span>
    <% end %>
  <% end %>
<% end %>
<%= render "layouts/shared/page_header", title: "Search" %>

<div class="stack stack--lg">
  <%= render "market/searches/tabs", current: @tab %>
  <%= render "market/searches/status", data: @data, settings: @settings %>

  <% if @tab == "searches" %>
    <%= render "market/searches/tracked", data: @data, settings: @settings, can_write: can_write %>
    <%= render "market/searches/console", console: @google, data: @data, can_write: can_write %>
    <%= render "market/searches/ideas", data: @data, can_write: can_write %>
    <%= render "market/searches/winners", data: @data, can_write: can_write %>
  <% elsif @tab == "ai" then %>
    <%= render "market/searches/ai", data: @data, settings: @settings %>
  <% elsif @tab == "website" then %>
    <%= render "market/searches/visibility", data: @data, settings: @settings, pull: pull %>
    <%= render "market/searches/links", data: @data %>
    <%= render "market/searches/site", data: @data %>
  <% else %>
    <%= render "market/searches/reviews", data: @data %>
    <%= render "market/searches/profiles", data: @data %>
  <% end %>
</div>

<%# A row opened: its facts and the AI's suggestions, in a sheet over the page; the address keeps it, so a reload (and the wait for the AI) keeps it open. %>
<turbo-frame id="market_sheet" data-turbo-action="advance">
  <% if @sheet %>
    <div class="contents" data-controller="dialog" data-dialog-modal-value="true" data-dialog-auto-open-value="true">
      <dialog class="dialog dialog--sheet dialog--sheet-half" data-dialog-target="dialog" aria-label="<%= @brief.label.upcase_first %>" closedby="any">
        <header class="dialog__header row row--between">
          <h2 class="heading heading--lg"><%= @brief.label.upcase_first %></h2>
          <%= link_to market_search_path, class: "btn btn--sm btn--plain", data: {turbo_frame: "market_sheet"} do %><%= icon_tag "close" %><span class="visually-hidden">Close</span><% end %>
        </header>
        <div class="stack stack--lg">
          <section class="stack stack--sm" aria-label="The facts"><%= render "market/workups/facts", brief: @brief %></section>
          <%= render "market/workups/workup", subject: @sheet, workup: @workup, can_write: can_write, back: market_search_path(sheet: @sheet) %>
        </div>
      </dialog>
    </div>
  <% end %>
</turbo-frame>

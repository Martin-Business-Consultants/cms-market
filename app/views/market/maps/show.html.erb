<% @page_title = "Maps" %>
<% can_write = Current.user.can?("market:write") %>
<% scan, before = @keyword && @scans[@keyword.id] %>

<% content_for :page_actions do %>
  <%= link_to "Search", market_search_path, class: "btn" %>
  <% if can_write %><%= link_to "The area", edit_market_profile_path, class: "btn" %><% end %>
<% end %>
<%= render "layouts/shared/page_header", title: "Maps" %>

<%# The searches and the open one in one frame: opening one, or a point on its map, swaps the right-hand column, keeping the address. %>
<turbo-frame id="market_maps" data-turbo-action="advance">
  <div class="grid grid--2 market-split">
    <section class="panel" aria-label="Searches">
      <% if @keywords.any? %>
        <ul class="divided">
          <% @keywords.each do |keyword| %>
            <%# herb:key keyword.id %>
            <% now, was = @scans[keyword.id] %>
            <% current = keyword == @keyword %>
            <li>
              <%= link_to market_maps_path(keyword: keyword.id), class: class_names("market-item", "market-item--current": current), aria: {current: (current ? "true" : nil)} do %>
                <span class="stack stack--2xs grow">
                  <span class="text-ink"><%= keyword.keyword %></span>
                  <span class="text-small text-muted">
                    <% if now %>
                      Top 3 at <%= (now.top3_share * now.points.size).round %> of <%= now.points.size %> · found at <%= now.found_points %>
                    <% else %>
                      Not scanned yet
                    <% end %>
                  </span>
                </span>
                <% if now %>
                  <span class="stack stack--2xs market-score">
                    <strong><%= now.average_position %></strong>
                    <% if was && was.average_position != now.average_position %>
                      <span class="<%= (now.average_position < was.average_position) ? "market-up" : "market-down" %>"><%= (now.average_position < was.average_position) ? "↑" : "↓" %><%= (was.average_position - now.average_position).abs.round(1) %></span>
                    <% end %>
                  </span>
                <% end %>
              <% end %>
            </li>
          <% end %>
        </ul>
      <% else %>
        <p class="empty-state">No searches tracked yet. <%= link_to "Track the searches customers make", market_search_path(anchor: "tracked"), class: "link", data: {turbo_frame: "_top"} %>; each is checked on Google Maps from every point on every pull.</p>
      <% end %>
    </section>

    <section class="panel panel--padded market-detail" aria-label="The map">
      <% if @keyword %>
        <div class="stack stack--lg">
          <div class="stack stack--xs">
            <h2 class="heading heading--lg"><%= @keyword.keyword %></h2>
            <% if scan %>
              <span class="text-small text-muted"><%= scan.grid %> × <%= scan.grid %> points within <%= scan.radius_miles.to_i %> miles of <%= scan.zip %> · scanned <%= l scan.checked_at.to_date, format: :long %> · average <strong><%= scan.average_position %></strong><%= " (was #{before.average_position})" if before %> · top 3 at <%= (scan.top3_share * scan.points.size).round %> of <%= scan.points.size %><% if (own = scan.own_rating) %> · <%= own["rating"] %>★ from <%= number_with_delimiter own["reviews"] %> reviews<% end %></span>
            <% end %>
          </div>

          <% profile = (defined?(::Google) && ::Google.respond_to?(:business_profile)) ? ::Google.business_profile : nil %>
          <% if (totals = profile&.totals) %>
            <dl class="market-facts text-small">
              <dt>Business Profile, 28 days</dt>
              <dd><%= number_with_delimiter(totals[:maps] + totals[:search]) %> views · <%= number_with_delimiter totals[:calls] %> calls · <%= number_with_delimiter totals[:directions] %> directions · <%= number_with_delimiter totals[:website] %> website clicks</dd>
              <% if profile.reviews["total"] %><dt>Reviews</dt><dd><%= profile.reviews["average"] %>★ from <%= number_with_delimiter profile.reviews["total"] %> · <%= profile.unanswered_reviews.size %> unanswered</dd><% end %>
            </dl>
          <% end %>

          <% if scan %>
            <% point = scan.points.find { "#{it["row"]}-#{it["col"]}" == @point } %>
            <div class="market-map">
              <div class="<%= class_names("market-grid market-grid--large", "market-grid--3": scan.grid == 3, "market-grid--7": scan.grid == 7) %>" role="group" aria-label="<%= scan.found_points %> of <%= scan.points.size %> points found; north at the top">
                <% scan.points.sort_by { [it["row"], it["col"]] }.each do |cell| %>
                  <%# herb:key "#{cell["row"]}-#{cell["col"]}" %>
                  <% position = cell["position"] %>
                  <% key = "#{cell["row"]}-#{cell["col"]}" %>
                  <%= link_to market_maps_path(keyword: @keyword.id, point: key),
                        class: class_names("market-grid__cell", "market-grid__cell--top": position.to_i.between?(1, 3), "market-grid__cell--mid": position.to_i.between?(4, 10), "market-grid__cell--low": !position.to_i.between?(1, 10), "market-grid__cell--current": key == @point),
                        title: "#{position ? "##{position}" : "Not in the top #{Market::LocalScan::DEPTH}"} at #{cell["lat"]}, #{cell["lng"]}" do %><%= position || "–" %><% end %>
                <% end %>
              </div>
              <div class="stack stack--xs text-small">
                <% if point %>
                  <strong><%= point["position"] ? "##{point["position"]} here" : "Not in the top #{Market::LocalScan::DEPTH} here" %></strong>
                  <span class="text-muted"><%= point["lat"] %>, <%= point["lng"] %> · <%= link_to "Open in Google Maps", "https://www.google.com/maps/search/#{ERB::Util.url_encode(@keyword.keyword)}/@#{point["lat"]},#{point["lng"]},14z", class: "link", target: "_blank", rel: "noopener" %></span>
                  <ol class="market-steps">
                    <% Array(point["top"]).each_with_index do |title, index| %>
                      <%# herb:key index %>
                      <li><%= index + 1 %>. <%= title %></li>
                    <% end %>
                  </ol>
                <% else %>
                  <span class="text-muted">Green is the top 3, amber 4 to 10, red further or not found. Choose a point to see who's shown there.</span>
                <% end %>
              </div>
            </div>

            <% if scan.leaders.any? %>
              <section class="stack stack--xs">
                <h3 class="label">Who leads the area</h3>
                <table class="data-table market-evidence-table">
                  <thead><tr><th>Business</th><th class="data-table__num">Top 3 at <span class="text-muted">(points)</span></th><th class="data-table__num">Rating</th><th></th></tr></thead>
                  <tbody>
                    <% competitors = Market::Competitor.all.to_a %>
                    <% scan.leaders.each do |leader| %>
                      <%# herb:key leader["title"] %>
                      <% watched = competitors.find { it.name.casecmp?(leader["title"].to_s) || (it.domain && it.domain == Market::Probe.normalize(leader["domain"])) } %>
                      <tr>
                        <td><strong><%= leader["title"] %></strong><div class="text-small text-muted"><%= [leader["category"], leader["domain"]].compact.join(" · ") %></div></td>
                        <td class="data-table__num"><%= leader["top3_points"] %>/<%= scan.points.size %></td>
                        <td class="data-table__num"><%= leader["rating"] ? "#{leader["rating"]}★ (#{number_with_delimiter leader["reviews"].to_i})" : "—" %></td>
                        <td>
                          <% if watched %>
                            <%= link_to "Watching", market_competitor_path(watched), class: "btn btn--sm btn--plain", data: {turbo_frame: "_top"} %>
                          <% elsif can_write then %>
                            <%= link_to "Watch", new_market_competitor_path(name: leader["title"], website: (leader["domain"] && "https://#{leader["domain"]}")), class: "btn btn--sm", data: {turbo_frame: "_top"} %>
                          <% end %>
                        </td>
                      </tr>
                    <% end %>
                  </tbody>
                </table>
              </section>
            <% end %>
          <% end %>

          <section class="stack stack--sm" aria-label="Next steps">
            <h3 class="heading">Next steps</h3>
            <%= render "market/shared/steps", steps: @steps.all, can_write: can_write, empty: "Nothing to do for this search right now." %>
          </section>

          <% if scan %>
            <%= render "market/workups/workup", subject: "map:#{@keyword.id}", workup: Market::Workup.latest("map:#{@keyword.id}"), can_write: can_write, back: market_maps_path(keyword: @keyword.id) %>
          <% end %>
        </div>
      <% else %>
        <div class="stack stack--sm market-detail__empty">
          <%= icon_tag "globe", class: "text-faint" %>
          <p class="text-muted">Track a search to see where the business shows on Google Maps.</p>
        </div>
      <% end %>
    </section>
  </div>
</turbo-frame>

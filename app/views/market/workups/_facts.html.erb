<%# locals: (brief:) %>
<%# The facts about one work-up's subject, as the person sees them beside the AI's suggestions. %>
<% record = brief.record %>
<% if brief.kind == "keyword" %>
  <% now, before = Market::Ranking.latest_for([record])[record.id] %>
  <% checks = Market::AiCheck.latest_for([record])[record.id] || {} %>
  <% facts = Market::SearchSnapshot.where(competitor_id: nil, kind: "keyword_facts").latest_first.first&.data&.dig("keywords", record.keyword) || {} %>
  <% if facts.any? %>
    <dl class="market-facts text-small">
      <% if facts["volume"] %><dt>Google searches a month</dt><dd><%= number_with_delimiter facts["volume"] %><%= " (#{facts["trend"]}% on the year)" if facts["trend"] %></dd><% end %>
      <% if facts["ai_volume"] %><dt>AI searches a month</dt><dd><%= number_with_delimiter facts["ai_volume"] %></dd><% end %>
      <% if facts["intent"] %><dt>What they want</dt><dd><%= facts["intent"].capitalize %></dd><% end %>
      <% if facts["difficulty"] %><dt>Difficulty</dt><dd><%= facts["difficulty"] %>/100</dd><% end %>
      <% if facts["cpc"] %><dt>Cost per click</dt><dd><%= market_money facts["cpc"] %></dd><% end %>
    </dl>
  <% end %>

  <section class="stack stack--xs">
    <h3 class="label">Google <%= market_source :live %></h3>
    <% if now %>
      <dl class="market-facts text-small">
        <dt>This site</dt><dd><%= market_position now.position, before&.position %><%= " with #{now.url}" if now.url %></dd>
        <dt>Checked</dt><dd><%= l now.checked_at.to_date, format: :long %></dd>
        <% if Array(now.features).any? %><dt>Also on the page</dt><dd><%= now.features.map { it.humanize.downcase }.join(", ") %></dd><% end %>
        <% if Array(now.local_pack).any? %><dt>Map pack</dt><dd><%= now.local_pack.map { "#{it["title"]}#{" (#{it["rating"]}★)" if it["rating"]}" }.join(" · ") %></dd><% end %>
      </dl>
      <table class="data-table market-evidence-table">
        <thead><tr><th>#</th><th>Result</th></tr></thead>
        <tbody>
          <% Array(now.results).first(10).each do |row| %>
            <%# herb:key row["position"] %>
            <tr><td><%= row["position"] %></td><td><strong><%= row["domain"] %></strong><div class="text-small text-muted"><%= row["title"] %></div></td></tr>
          <% end %>
        </tbody>
      </table>
      <% if Array(now.questions).any? %>
        <div class="stack stack--2xs">
          <span class="text-small text-muted">People also ask: answer these on the page</span>
          <ul class="market-changes text-small">
            <% now.questions.each do |question| %>
              <%# herb:key question %>
              <li><%= question %></li>
            <% end %>
          </ul>
        </div>
      <% end %>
    <% else %>
      <p class="text-small text-muted">Not checked yet: the next pull checks who ranks where.</p>
    <% end %>
  </section>

  <section class="stack stack--xs">
    <h3 class="label">AI search <%= market_source :ai %></h3>
    <% if checks.any? %>
      <ul class="divided">
        <% Market::AiCheck::PLATFORMS.each_key do |platform| %>
          <%# herb:key platform %>
          <% check = checks[platform] %>
          <% next unless check %>
          <li class="market-row stack stack--xs">
            <span class="cluster cluster--sm">
              <%= market_ai_mark check %>
              <strong><%= check.platform_name %></strong>
              <span class="text-small text-muted">
                <% if !check.answered %>
                  <%= check.error.presence || "No answer" %>
                <% elsif check.mentioned then %>
                  Named <%= check.mention_rank.to_i.ordinalize %><%= ", and cited the site" if check.cited %>
                <% elsif check.cited then %>
                  Cited the site without naming the business
                <% else %>
                  Answered without the business
                <% end %>
                · <%= time_ago_in_words(check.checked_at) %> ago
              </span>
            </span>
            <% if check.named.any? %>
              <span class="text-small">Named: <%= check.named.map { "#{it["rank"]}. #{it["name"]}" }.join(" · ") %></span>
            <% end %>
            <% if check.source_domains.any? %>
              <span class="text-small text-muted">Cites: <%= check.source_domains.first(8).join(", ") %></span>
            <% end %>
            <% if check.answer.present? %>
              <details class="market-closed text-small">
                <summary>The answer<%= " (#{check.model})" if check.model.present? %></summary>
                <div class="market-text market-answer"><%= check.answer %></div>
              </details>
            <% end %>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p class="text-small text-muted">Not asked yet: the next pull asks each AI chosen in Settings › Market.</p>
    <% end %>
  </section>
<% elsif brief.kind == "map" then %>
  <% scan = Market::LocalScan.latest_for([record])[record.id]&.first %>
  <p class="text-small"><%= scan ? "Average #{scan.average_position} on Google Maps; in the top 3 at #{(scan.top3_share * scan.points.size).round} of #{scan.points.size} points." : "Not scanned yet." %>
    <%= link_to "The map", market_maps_path(keyword: record.id), class: "link", data: {turbo_frame: "_top"} %></p>
<% elsif brief.kind == "finding" then %>
  <div class="cluster cluster--sm"><%= market_severity_tag record %><span class="text-small text-muted"><%= record.channel_label %></span></div>
  <% if record.detail.present? %><p class="market-text"><%= record.detail %></p><% end %>
  <%= market_evidence record.evidence %>
<% elsif brief.kind == "page" then %>
  <% console = (defined?(::Google) && ::Google.respond_to?(:search_console)) ? ::Google.search_console : nil %>
  <% seo = record.seo.to_h %>
  <dl class="market-facts text-small">
    <dt>Page</dt><dd><%= link_to "/#{(record.path == "home") ? "" : record.path}", edit_page_path(record.path), class: "link", data: {turbo_frame: "_top"} %> <span class="text-muted">(<%= record.status %>)</span></dd>
    <dt>Meta title</dt><dd><%= seo["meta_title"].present? ? seo["meta_title"] : tag.span("Not set", class: "text-muted") %></dd>
    <dt>Meta description</dt><dd><%= seo["meta_description"].present? ? seo["meta_description"] : tag.span("Not set", class: "text-muted") %></dd>
  </dl>
  <% found = console ? console.queries_for(record.path) : [] %>
  <% if found.any? %>
    <table class="data-table market-evidence-table">
      <thead><tr><th>Found on Google for</th><th class="data-table__num">Impressions</th><th class="data-table__num">Clicks</th><th class="data-table__num">Position</th></tr></thead>
      <tbody>
        <% found.each do |row| %>
          <%# herb:key row["keys"][0] %>
          <tr><td><%= row["keys"][0] %></td><td class="data-table__num"><%= number_with_delimiter row["impressions"] %></td><td class="data-table__num"><%= number_with_delimiter row["clicks"] %></td><td class="data-table__num"><%= row["position"].to_f.round(1) %></td></tr>
        <% end %>
      </tbody>
    </table>
  <% end %>
<% elsif brief.kind == "links" then %>
  <% links = brief.links %>
  <% own = links.own_site %>
  <dl class="market-facts text-small">
    <dt>Linking sites</dt><dd><%= own&.figure("referring_domains") ? number_with_delimiter(own.figure("referring_domains")) : "—" %></dd>
    <dt>Won · lost, <%= links.changes["days"] || 90 %> days</dt><dd><%= links.changes["won_count"].to_i %> · <%= links.changes["lost_count"].to_i %></dd>
    <dt>Links to pages that are gone</dt><dd><%= pluralize(links.unfixed.sum { it["sites"].to_i }, "site") %>, <%= pluralize(links.unfixed.size, "page") %></dd>
    <dt>Linking to competitors, not to it</dt><dd><%= number_with_delimiter links.gap["total"].to_i %></dd>
  </dl>
<% elsif brief.kind == "opportunity" then %>
  <div class="cluster cluster--sm"><%= market_impact_tag record %><%= market_effort_tag record %><span class="text-small text-muted"><%= record.channel_label %> · <%= record.horizon_label %></span></div>
  <% if record.detail.present? %><p class="market-text"><%= record.detail %></p><% end %>
  <% if record.evidence.present? %><p class="text-small text-muted market-text">Why: <%= record.evidence %></p><% end %>
<% else %>
  <% site = Market::Search::Overview.new.sites.find { record ? it.competitor == record : it.own? } %>
  <% if site&.pulled? %>
    <dl class="market-facts text-small">
      <dt>Keywords</dt><dd><%= market_change site.figure("organic_keywords"), site.before("organic_keywords") %></dd>
      <dt>Traffic (est./mo)</dt><dd><%= market_change site.figure("organic_traffic"), site.before("organic_traffic") %></dd>
      <dt>Top 3 · top 10</dt><dd><%= number_with_delimiter site.figure("top_3") %> · <%= number_with_delimiter site.figure("top_10") %></dd>
      <dt>Paid keywords</dt><dd><%= number_with_delimiter site.figure("paid_keywords") %></dd>
    </dl>
    <% best = Array(site.keywords&.data&.dig("keywords")).sort_by { -it["volume"].to_i }.first(8) %>
    <% if best.any? %>
      <table class="data-table market-evidence-table">
        <thead><tr><th>Their best keywords</th><th class="data-table__num">#</th><th class="data-table__num">Searches/mo</th></tr></thead>
        <tbody>
          <% best.each do |row| %>
            <%# herb:key row["keyword"] %>
            <tr><td><%= row["keyword"] %></td><td class="data-table__num"><%= row["position"] %></td><td class="data-table__num"><%= number_with_delimiter row["volume"] %></td></tr>
          <% end %>
        </tbody>
      </table>
    <% end %>
  <% else %>
    <p class="text-small text-muted">No search data for it yet.</p>
  <% end %>
<% end %>
